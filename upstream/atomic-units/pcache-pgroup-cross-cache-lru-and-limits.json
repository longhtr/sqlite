  "dependencies": {
    "atomic_unit_ids": [
      "pcache-process-lifecycle-and-static-buffer",
      "pcache-static-slot-allocation-and-free",
      "pthread-mutex-enter-leave-core"
    ],
    "external_source_responsibilities": [
      "Exact upper pcache.c dirty/stress/reference coupling"
    ],
    "caller_closure": "Production Pager caches use Cache. Unified target mode is selected only for a startup static page buffer with core mutexes disabled, matching the active profile. Separate caches retain private groups."
  },
  "contracts": {
    "inputs": [
      "Cache page/extra size, purgeability and maximum; key and create mode; pin/unpin/reuse decision; memory pressure"
    ],
    "outputs": [
      "Hit/miss/create result, pinned page, exact cross-cache recycled buffer, page count, or rejected soft create"
    ],
    "ownership": "Each allocated page belongs to one Cache hash at a time and one PGroup purgeable count. An unpinned clean page belongs to exactly one intrusive group LRU. Cross-cache recycling transfers cache/hash ownership without freeing the underlying slot.",
    "state_and_results": "Create/destroy and cache-size changes update nMax/nMin/mxPinned. Allocation/free update nPurgeable. Unpin inserts at LRU head; pin removes. Recycle and enforcement take the LRU tail across all group members. Shrink temporarily enforces group maximum zero.",
    "locks_callbacks_io": "The active unified mode has core mutexes disabled, so source PGroup mutex is null. Separate mode uses private groups. No I/O occurs; dirty stress remains an upper-cache callback.",
    "failure_and_continuation": "Hash/event capacity OOM before transfer leaves victim and both caches unchanged. Wrong-sized victims are freed before ordinary allocation. Limit enforcement stops when no clean unpinned victim exists; pinned/dirty pages remain usable."
  },
