    "external_source_responsibilities": [
      "sqlite3_serialize/sqlite3_deserialize store replacement and ownership flags remain separate units",
      "Configured-mutex callback concurrency beyond the exact shared-store allocation/open/close lifecycle remains assurance work"
    ],
    "caller_closure": "Production memdb registration routes opens into MemoryVfs.initMemdb and source-shaped ABI tails. Shared/private lifetime, doubled growth and limits, file controls, byte I/O, reader/writer locking, rollback-only behavior, and process allocator ownership are integrated."
  },
  "contracts": {
    "inputs": [
      "Memdb VFS filename, open flags, file operation parameters, lock level, and byte ranges"
    ],
    "outputs": [
      "Source-family result code, shared/private handle, copied bytes, size, lock transition, or nullable mapped pointer"
    ],
    "ownership": "Absolute names longer than one byte share a store until last close. Other names own a private store per handle. Handles borrow stores; last close destroys bytes/name/store.",
    "state_and_results": "Shared opens reuse content; private opens do not. Reads zero-fill short tails. Writes grow contiguous bytes. Sync is a no-op. Truncate cannot grow. Ordinary resizable memdb fetch returns null. Lock upgrades preserve one writer and reader exclusion.",
    "locks_callbacks_io": "No external I/O. Shared-name lookup/last-close publication and every MemStore operation are serialized with registry and per-store mutexes in source lock order; private stores use the same safe owner without registry publication.",
    "failure_and_continuation": "Open allocation failure publishes no handle/store. Growth beyond szMax or while non-resizable/mapped returns FULL; allocation failure returns IOERR_NOMEM without size/content mutation. Busy lock attempts preserve prior levels; last-close cleanup permits fresh reopening."
  },
