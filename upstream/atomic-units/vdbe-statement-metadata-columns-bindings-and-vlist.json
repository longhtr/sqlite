  },
  "contracts": {
    "inputs": [
      "Nullable or live source-layout VDBE, result-row index, parameter identity, status operation, and connection",
      "Source-layout Mem result/binding arrays and allocator-owned VList"
    ],
    "outputs": [
      "Exact nullable metadata and result-column value conversions",
      "Stable parameter count/name/index and moved-or-cleared binding owners",
      "Statement-list traversal, counters, SQL owner, safety/expiration state, and normalized API result"
    ],
    "ownership": "Column access borrows result Mem storage; sqlite3_column_value converts static ownership to ephemeral. Binding transfer moves each Mem owner and nulls the source. VList growth preserves the old allocation on OOM. MEMUSED performs byte-count destruction without unlinking or freeing the live statement.",
    "state_and_results": "Column APIs hold the connection mutex from column lookup through allocation-failure normalization. Invalid columns set RANGE. OOM at API exit becomes NOMEM and clears sticky OOM when no VDBE executes. Clear/transfer expiration follows expmask and SAVESQL invariants.",
    "locks_callbacks_io": "Connection mutex brackets mutable statement, binding, list, and error state. Safety failures invoke the configured log callback. No direct I/O in the selected slice.",
    "failure_and_continuation": "VList realloc OOM returns the original list unchanged. Column conversion OOM is normalized at API exit. Statements and binding arrays remain reusable after clear, move, invalid-column access, and status reads."
  },
