  "contracts": {
    "inputs": [
      "serial type and at least its encoded payload bytes; destination Mem"
    ],
    "outputs": [
      "payload length and source-shaped Mem flags/scalar/view fields"
    ],
    "ownership": "Scalar/NULL values own no payload. Text/blob outputs are MEM_Ephem views into caller-owned input bytes. No prior Mem owner is released because source requires fresh destination state.",
    "state_and_results": "Types 0/11 are NULL; 10 is NULL|Zero no-change; 1..6 are signed big-endian integers; 7 is big-endian f64 with NaN mapped to NULL; 8/9 are integer 0/1; >=12 alternates blob/text and length floor((N-12)/2).",
    "locks_callbacks_io": "No connection, lock, callback, allocation, or I/O.",
    "failure_and_continuation": "No failure path. serialGet7 returns one for NaN and zero for real while the public decoder communicates through Mem flags."
  },
