  "contracts": {
    "inputs": [
      "Allocator, optional underlying sqlite3_vfs/name, open flags, spill threshold, offsets, byte spans, truncate sizes and sync flags"
    ],
    "outputs": [
      "Exact SQLite result code, read bytes, file size, memory/spilled identity"
    ],
    "ownership": "Each in-memory chunk is one allocation containing link plus payload. Journal owns and frees chunks. Successful spill transfers behavior to an owned underlying sqlite3_file allocation; failed spill closes the provisional file and retains every chunk.",
    "state_and_results": "Endpoint and readpoint preserve source cursor semantics. Writes append except the bounded header rewrite and truncate-before-rewrite path. Threshold zero opens the real file immediately, negative remains memory-only, and positive spills when exceeded.",
    "locks_callbacks_io": "Memjournal has no mutex. In-memory methods perform no I/O. Spill invokes underlying xOpen/xWrite and later routes read/write/truncate/sync/size/close through its method table.",
    "failure_and_continuation": "Short reads do not mutate cursors, chunk OOM returns IOERR_NOMEM with a closable prefix, and failed spill preserves in-memory rollback content for continuation."
  },
